{
  "name": "@tailor-cms/ce-html-edit",
  "description": "Tailor CMS HTML editor authoring component",
  "author": "Studion <info@gostudion.com> (https://github.com/tailor-cms)",
  "type": "module",
  "version": "0.2.1",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "pnpm nuke:dist && vue-tsc && vite build",
    "lint": "eslint ./src",
    "lint:fix": "pnpm lint --fix",
    "nuke": "pnpm dlx del-cli dist node_modules",
    "nuke:dist": "pnpm dlx del-cli dist",
    "prepublish": "pnpm build"
  },
  "peerDependencies": {
    "vue": "^3.5.29"
  },
  "devDependencies": {
    "@tailor-cms/ce-html-manifest": "workspace:*",
    "@tailor-cms/eslint-config": "2.0.0-beta.14",
    "@types/lodash-es": "^4.17.12",
    "@types/validator": "^13.15.10",
    "@vitejs/plugin-vue": "^6.0.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.9",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vue-tsc": "^3.2.7",
    "vuetify": "^4.0.6"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@intevation/tiptap-extension-office-paste": "^0.1.2",
    "@tailor-cms/cek-common": "2.0.0-beta.14",
    "@tiptap/extension-image": "^3.22.4",
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/extension-subscript": "^3.22.4",
    "@tiptap/extension-superscript": "^3.22.4",
    "@tiptap/extension-table": "^3.22.4",
    "@tiptap/extension-text-align": "^3.22.4",
    "@tiptap/extension-text-style": "^3.22.4",
    "@tiptap/extensions": "^3.22.4",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "@tiptap/vue-3": "^3.22.4",
    "lodash-es": "^4.18.1",
    "validator": "^13.15.35"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  }
}
